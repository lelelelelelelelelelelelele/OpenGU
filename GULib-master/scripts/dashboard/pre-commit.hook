#!/bin/sh
# pre-commit hook — project WorkItem status into WORKPLAN and progress.html.
#
# WORKPLAN owns orchestration; WORKITEM.md owns lifecycle; progress.html and the
# WORKPLAN status region are derived snapshots.
# This TRACKED copy is canonical (git hooks live in .git/hooks and are NOT
# version-controlled). To ACTIVATE, install it once from the repo root
# (the directory that contains GULib-master/):
#
#     cp GULib-master/scripts/dashboard/pre-commit.hook .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
# After that, commits touching WORKPLAN or a WorkItem regenerate and re-stage
# both projections. Until installed, regenerate manually:
#     python GULib-master/scripts/dashboard/refresh.py
#
if git diff --cached --name-only | grep -Eq 'GULib-master/(self/dashboard/WORKPLAN\.md|\.workblock/items/[^/]+/WORKITEM\.md)'; then
  PY="E:/conda_package/envs/gnn/python.exe"
  if [ ! -f "$PY" ]; then PY="python"; fi
  echo "[pre-commit] orchestration/status changed -> regenerating dashboard projections"
  "$PY" GULib-master/scripts/dashboard/refresh.py || exit 1
  git add GULib-master/self/dashboard/WORKPLAN.md GULib-master/self/dashboard/progress.html
fi
exit 0
