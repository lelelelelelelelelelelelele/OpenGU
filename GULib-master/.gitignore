# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~

# Local Claude Code settings
.claude/settings.local.json

# Results, caches, checkpoints and diagnostics are device-local artifacts.
# Existing tracked documentation and historical paper assets remain tracked
# until their owners retire them; ignoring this directory does not delete files.
/results/

# Runtime logs (timestamped, large, regenerable)
log/
logs/
report/daily-log/

# Archives — paper template downloads, overleaf bundles, scp 回收 tar 等
*.zip
*.tar
*.tar.gz
*.md5

# NeurIPS template unzip dir (redundant with zip, regeneratable)
report/paper/NeurIPS_2025_template/

GEMINI.md

# LaTeX build artifacts
*.aux
*.log
*.bbl
*.blg
*.out

# Device-local syncmate identity/state. This is intentionally different on
# each machine and must not be committed.
.syncmate/

# Local agent/task planning scratch state.
.planning/

# Transient WorkBlock supervision state.
/.workblock/runtime/

# Persistent WorkBlock graph published in canonical A.
/.workblock/graph.json

# Optional high-DPI raster exports for Cache architecture diagrams. The
